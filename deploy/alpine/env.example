# Settings for mcp-server-batocera (deploy/alpine): root:mcp-batocera, mode 0640. Sourced by
# run.sh as shell: KEY=value, quote values with spaces. Both the service and the command on
# PATH read it; a variable set in the caller's environment wins over this file.
# After changing it: rc-service mcp-server-batocera restart

# EmulationStation's web API: the cabinet's IP address (a bare address gets http:// and :1234).
# It answers other machines only with Enable public web access on (HARDWARE_VALIDATION.md step 1).
BATOCERA_URL=http://batocera.local:1234

# Optional. config.json in this directory can hold the same settings (environment wins).
BATOCERA_CONFIG_DIR=/etc/mcp-server-batocera
#BATOCERA_NAME="Game room cabinet"
#BATOCERA_RETROARCH_PORT=55355
#BATOCERA_TIMEOUT=10
#BATOCERA_DRY_RUN=1
#BATOCERA_DEBUG=1

# --- HTTP and Cloudflare Access (the service) -------------------------------------------
# Where the service listens. 127.0.0.1 when cloudflared runs in this same container or
# machine (recommended); this machine's LAN address if cloudflared runs elsewhere (then
# Access is required). Without CF_ACCESS_* it serves only requests that start on this
# machine, and answers 403 to anything a tunnel forwards (src/batocera_mcp/remote.py).
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8717
MCP_HTTP_PATH=/batocera/mcp
# The public hostname Cloudflare forwards (Host header checks).
#MCP_PUBLIC_HOSTS=mcp.example.com

# Cloudflare Access: the team domain and the Access application's AUD tag. Every request
# must then carry a valid Access assertion, checked here as well as at Cloudflare's edge.
#CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
#CF_ACCESS_AUD=<the Access application's AUD tag>
# Optional: only these identities, on top of whatever the Access policy admits.
#MCP_ALLOWED_EMAILS=you@example.com
