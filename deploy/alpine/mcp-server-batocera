#!/bin/sh
# /usr/local/bin/mcp-server-batocera: run the CLI as user mcp-batocera with its settings.
# root drops to the user; the user itself (or anyone else allowed to read the
# settings) runs it directly.
STATE=/var/lib/mcp-server-batocera
RUN=/opt/mcp-server-batocera/run.sh
if [ "$(id -u)" = 0 ]; then
	HOME=$STATE exec su-exec mcp-batocera "$RUN" "$@"
fi
exec "$RUN" "$@"
